<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_rounded">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/EDIT_GADGET"
                android:textColor="@color/colorOnBackground"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Crop data -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <EditText
                        android:id="@+id/etCropName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/CROP_NAME"
                        android:inputType="text"
                        android:textAlignment="viewStart"
                        tools:ignore="Autofill" />

                    <AutoCompleteTextView
                        android:id="@+id/actGrowthStage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_outlined_box"
                        android:drawableEnd="@drawable/ic_arrow_down"
                        android:drawablePadding="8dp"
                        android:hint="@string/GROWTH_STAGE"
                        android:inputType="none"
                        android:padding="14dp"
                        android:textAlignment="viewStart"
                        tools:ignore="LabelFor" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUpdateCrop"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/UPDATE_CROP" />

            </LinearLayout>

            <!-- Gadget name -->
            <EditText
                android:id="@+id/etGadgetName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:hint="@string/Enter_Gadget_Name"
                android:inputType="text"
                android:textAlignment="viewStart"
                tools:ignore="Autofill" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancel"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Cancel" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRename"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/Rename" />

            </LinearLayout>

        </LinearLayout>
    </FrameLayout>
</layout>